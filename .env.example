# Copy this file to .env.local for local development.
# On Vercel, set these in Project Settings -> Environment Variables instead
# (POSTGRES_URL is set automatically if you use Vercel's Postgres integration).

# --- Database ---
# Either POSTGRES_URL (auto-set by Vercel Postgres) or DATABASE_URL works.
POSTGRES_URL="postgres://user:password@host:5432/dbname?sslmode=require"

# --- Auth.js / NextAuth ---
# Generate one locally with: npx auth secret
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Google OAuth credentials (Google Cloud Console -> APIs & Services -> Credentials)
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# NEXTAUTH_URL is NOT needed on Vercel (it's inferred automatically).
# Only set it if you deploy somewhere else, e.g.:
# NEXTAUTH_URL="https://your-app.example.com"
